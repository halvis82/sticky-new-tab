{
  "manifest_version": 3,
  "key": "",
  "name": "Sticky New Tab",
  "version": "1.2.0",
  "description": "Persistent, movable sticky notes on the new tab page. Everything stored locally.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "topSites",
    "favicon"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "host_permissions": [
    "https://www.google.com/"
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}